project(slam_example)
cmake_minimum_required(VERSION 3.16)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

set(UNITREE_DDS_LIB_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../../unitree_sdk2/thirdparty/lib/${CMAKE_SYSTEM_PROCESSOR}")
set(CMAKE_BUILD_RPATH "${UNITREE_DDS_LIB_DIR};/opt/ros/humble/lib;/mnt/ssd/navgation/projects/custom_action_ws/install/custom_action_interfaces/lib")
set(CMAKE_INSTALL_RPATH "${UNITREE_DDS_LIB_DIR};/opt/ros/humble/lib;/mnt/ssd/navgation/projects/custom_action_ws/install/custom_action_interfaces/lib")
set(CMAKE_INSTALL_RPATH_USE_LINK_PATH TRUE)

include_directories(/usr/local/include include)

find_package(unitree_sdk2 REQUIRED)
find_package(rclcpp REQUIRED)
find_package(rclcpp_action REQUIRED)
find_package(std_msgs REQUIRED)
find_package(geometry_msgs REQUIRED)
find_package(custom_action_interfaces REQUIRED)

add_executable(keyDemo src/keyDemo.cpp)
set_target_properties(keyDemo PROPERTIES OUTPUT_NAME keyDemo_bin)
target_link_libraries(keyDemo unitree_sdk2)

set(KEYDEMO_WRAPPER "${CMAKE_CURRENT_BINARY_DIR}/keyDemo")
file(GENERATE OUTPUT "${KEYDEMO_WRAPPER}" CONTENT [=[#!/usr/bin/env bash
set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
EXAMPLE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
PROJECTS_DIR="$(cd "$EXAMPLE_DIR/../.." && pwd)"
ROS_SETUP="/opt/ros/humble/setup.bash"
WS_SETUP="$PROJECTS_DIR/custom_action_ws/install/setup.bash"
UNITREE_DDS_LIB="$PROJECTS_DIR/unitree_sdk2/thirdparty/lib/$(uname -m)"
CUSTOM_ACTION_LIB="$PROJECTS_DIR/custom_action_ws/install/custom_action_interfaces/lib"

set +u
source "$ROS_SETUP"
source "$WS_SETUP"
export LD_LIBRARY_PATH="$UNITREE_DDS_LIB:/opt/ros/humble/lib:$CUSTOM_ACTION_LIB"
set -u

exec "$SCRIPT_DIR/keyDemo_bin" "$@"
]=])
add_custom_command(TARGET keyDemo POST_BUILD
    COMMAND /bin/chmod +x "${KEYDEMO_WRAPPER}")

