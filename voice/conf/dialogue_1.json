{
  "variables": {
    "leader_calling": "各位领导"
  },
  "opening": {
    "short_mode_leader_calling": "{leader_calling}",
    "short_mode_intro": "欢迎您来到滨湖复星人形机器人产业园。我叫小智，可以带您参观展区，也可以回答您的问题。",
    "short_mode_ready": "如果您想开始参观，可以直接告诉我。",
    "handshake_greeting": "{leader_calling}您好，我叫小智。",
    "handshake_welcome": "欢迎您来到滨湖复星人形机器人产业园。",
    "group_welcome": "各位朋友，也欢迎你们！",
    "follow_intro": "{leader_calling}，各位，请随我来，我简单的介绍一下园区。"
  },
  "steps": [
    {
      "scene": "过渡1",
      "entity_key": "console_point_过渡1",
      "segments": []
    },
    {
      "scene": "点咖啡",
      "entity_key": "point_2",
      "skip_navigation_if_current": true,
      "segments": [
        {
          "text": "对了，{leader_calling}、各位，我们给各位准备了咖啡还有其他饮料，我让我的小伙伴给送过来。"
        },
        {
          "action": "right_hand_up",
          "text": "我来给各位安排。",
          "speak_with_action": true,
          "background_command_name": "呼叫AIR咖啡车",
          "background_command_once_key": "coffee_delivery_run",
          "background_command": "coffee_delivery_run"
        }
      ]
    },
    {
      "scene": "初步介绍",
      "entity_key": "point_3",
      "segments": [
        {
          "text": "我们产业园2025年12月开园后，我们紧扣人形机器人核心赛道，做了大量工作，除了提升园区的软件和硬件水平外，我们还不断加大产业项目招引，目前，签约共创实验室平台1个，签约机器人产研项目20余个，成果十分显著。",
          "speak_during_navigation": true
        }
      ]
    },
    {
      "scene": "拿取咖啡",
      "entity_key": "point_3",
      "skip_navigation_if_current": true,
      "segments": [
        {
          "action": "right_hand_up",
          "text": "{leader_calling}，咖啡和饮料来了，请您还有各位朋友自取。"
        }
      ]
    },
    {
      "scene": "前往3到5过渡点",
      "entity_key": "point_5",
      "skip_navigation_if_current": true,
      "segments": []
    },
    {
      "scene": "告别并指引小巴方向",
      "entity_key": "console_point_告别并指引小巴方向",
      "segments": [
        {
          "text": "{leader_calling}、各位领导，下面请移步门外，乘坐无人驾驶小巴车深入了解我们园区。"
        },
        {
          "text": "各位再会！"
        }
      ]
    }
  ],
